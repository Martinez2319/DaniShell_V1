<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DaniShell\DaniShell.csproj" />
    <ProjectReference Include="..\Samples\HelloPlugin\HelloPlugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyFixturePlugin" AfterTargets="Build">
    <ItemGroup>
      <FixturePlugin Include="../Samples/HelloPlugin/bin/$(Configuration)/net8.0/HelloPlugin.dll;../Samples/HelloPlugin/HelloPlugin.plugin.json" />
    </ItemGroup>
    <Copy SourceFiles="@(FixturePlugin)" DestinationFolder="$(OutDir)fixture-plugin" />
  </Target>
</Project>
